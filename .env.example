# Copie para .env (lido automaticamente ao rodar da raiz do projeto).

# Segredo do JWT. PRECISA ser o mesmo valor do usuario-api, que é quem emite o token: é o
# que faz o token dele valer aqui. Gere com: openssl rand -base64 48
NEXO_JWT_SECRET=

# Banco (mesmos valores do docker-compose.yml). É um banco PRÓPRIO, separado dos outros serviços.
# A porta 5439 é a que o compose publica no host (DB_HOST_PORT); só vale para rodar a API
# fora do Docker com ./mvnw spring-boot:run.
DB_URL=jdbc:postgresql://localhost:5439/gamificacao_db
DB_USER=nexo_admin
DB_PASSWORD=

# Dados de exemplo (jogadores, desafios, quiz). Só em desenvolvimento. Os
# jogadores usam os mesmos ids de aluno do seed do usuario-api: ligue os seeds juntos.
NEXO_SEED_ENABLED=true

CORS_ALLOWED_ORIGINS=http://localhost:4200

# pedagogico-api: de onde vêm a turma e a etapa do aluno. NEXO_PEDAGOGICO_ENABLED=false desliga
# a consulta (nenhum desafio é filtrado por etapa).
NEXO_PEDAGOGICO_URL=http://localhost:8082
NEXO_PEDAGOGICO_ENABLED=true
